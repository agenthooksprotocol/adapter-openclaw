{
  "name": "@agenthooksprotocol/adapter-openclaw",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent Hooks Protocol adapter for OpenClaw, as an OpenClaw plugin",
  "license": "Apache-2.0",
  "repository": "github:agenthooksprotocol/adapter-openclaw",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "agent-hooks-protocol"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.36",
      "minGatewayVersion": "2026.9.36"
    },
    "build": {
      "openclawVersion": "2026.10.10",
      "pluginSdkVersion": "2026.10.10"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test test/unit",
    "test:e2e": "npm run build && bun test --timeout 120000 test/e2e",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "agenthooksprotocol": "0.11.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.36"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "@types/node": "24.10.1",
    "openclaw": "2026.10.10",
    "openclaw-floor": "npm:openclaw@2026.9.36",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
